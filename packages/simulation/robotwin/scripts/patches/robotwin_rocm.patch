@@ -38,6 +38,54 @@ class Base_Task(gym.Env):
     def __init__(self):
         pass
 
+    def _get_eval_video_frame(self):
+        # Render the current scene live for every eval frame so all panels are
+        # continuous during policy execution. The policy only refreshes
+        # self.now_obs at replan boundaries, so reading it here made the head and
+        # wrist panels jump from keyframe to keyframe (only the live-rendered
+        # observer stayed smooth).
+        self._update_render()
+        self.cameras.update_picture()
+        rgb = self.cameras.get_rgb()
+        head_rgb = rgb["head_camera"]["rgb"]
+
+        if "left_camera" not in rgb or "right_camera" not in rgb:
+            return head_rgb
+
+        left_rgb = rgb["left_camera"]["rgb"]
+        right_rgb = rgb["right_camera"]["rgb"]
+        bottom_rgb = np.concatenate([left_rgb, right_rgb], axis=1)
+
+        # Top row = [head | third-person observer]. The observer is a sim-only
+        # camera (absent from the dataset / policy input); rendering it here fills
+        # the quadrant that is otherwise zero-padded, since the head cam is
+        # narrower than the two wrist cams placed side by side.
+        top_rgb = head_rgb
+        try:
+            h, w = head_rgb.shape[:2]
+            observer_rgb = np.asarray(self.cameras.get_observer_rgb())[:, :, :3]
+            if observer_rgb.shape[:2] != (h, w):
+                ys = np.linspace(0, observer_rgb.shape[0] - 1, h).astype(np.int64)
+                xs = np.linspace(0, observer_rgb.shape[1] - 1, w).astype(np.int64)
+                observer_rgb = observer_rgb[ys][:, xs]
+            top_rgb = np.concatenate([head_rgb, observer_rgb], axis=1)
+        except Exception:
+            top_rgb = head_rgb
+
+        target_w = max(top_rgb.shape[1], bottom_rgb.shape[1])
+
+        def _pad_width(rgb, width):
+            if rgb.shape[1] == width:
+                return rgb
+            if rgb.shape[1] > width:
+                return rgb[:, :width, :]
+            pad_w = width - rgb.shape[1]
+            return np.pad(rgb, ((0, 0), (0, pad_w), (0, 0)), mode="constant")
+
+        top_rgb = _pad_width(top_rgb, target_w)
+        bottom_rgb = _pad_width(bottom_rgb, target_w)
+        return np.concatenate([top_rgb, bottom_rgb], axis=0)
+
